pipeline {

    agent any


    environment {

        IMAGE_NAME="spring-petclinic"

    }


    stages {


        stage('Checkstyle') {

            steps {

                sh './mvnw checkstyle:check'

            }

            post {

                always {

                    archiveArtifacts artifacts: '**/target/checkstyle-*'

                }

            }

        }



        stage('Test') {

            steps {

                sh './mvnw test'

            }

        }



        stage('Build') {

            steps {

                sh './mvnw package -DskipTests'

            }

        }



        stage('Docker Build') {

            steps {

                sh """

                docker build \
                -f Dockerfile.multi \
                -t ${IMAGE_NAME}:${GIT_COMMIT} .

                """

            }

        }



        stage('Push Docker Image') {


            steps {

                script {


                    if(env.BRANCH_NAME == 'main') {


                        sh """

                        docker tag ${IMAGE_NAME}:${GIT_COMMIT} localhost:8083/${IMAGE_NAME}:latest

                        docker push localhost:8083/${IMAGE_NAME}:latest

                        """


                    }


                    else {


                        sh """

                        docker tag ${IMAGE_NAME}:${GIT_COMMIT} localhost:8084/${IMAGE_NAME}:${GIT_COMMIT}

                        docker push localhost:8084/${IMAGE_NAME}:${GIT_COMMIT}

                        """


                    }

                }

            }

        }


    }

}