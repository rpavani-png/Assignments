pipeline {

    agent any

    environment {
        IMAGE_NAME = "localhost:8083/mr"
    }


    stages {


        stage('Checkstyle') {

            steps {

                dir('Spring-Petclinic-Assignments/spring-petclinic') {

                    sh './mvnw checkstyle:check'

                }

            }

            post {

                always {

                    archiveArtifacts artifacts: '**/target/checkstyle-result.xml',
                    allowEmptyArchive: true

                }

            }
        }



        stage('Test') {

            steps {

                dir('Spring-Petclinic-Assignments/spring-petclinic') {

                    sh './mvnw test'

                }

            }
        }



        stage('Build') {

            steps {

                dir('Spring-Petclinic-Assignments/spring-petclinic') {

                    sh './mvnw package -DskipTests'

                }

            }
        }



        stage('Docker Build') {

            steps {

                dir('Spring-Petclinic-Assignments/spring-petclinic') {

                    sh """

                    docker build \
                    -f Dockerfile.multi \
                    -t ${IMAGE_NAME}:${GIT_COMMIT[0..6]} .

                    """

                }

            }

        }



        stage('Push Docker Image') {

            steps {

                sh """

                docker push ${IMAGE_NAME}:${GIT_COMMIT[0..6]}

                """

            }

        }


    }

}